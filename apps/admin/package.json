{
  "name": "@vivamama/admin",
  "author": "VivaMama",
  "license": "Apache-2.0",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "VivaMama admin console \u2014 the operations surface for consultations, content moderation and the mother roster, served by @vivamama/backend.",
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "fm:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "fm:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "fix:all": "pnpm run lint:fix && pnpm run fm:fix",
    "clean": "rimraf dist node_modules/.tmp",
    "tsc:watch": "tsc --noEmit --watch"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vivamama/contracts": "workspace:*",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/poppins": "^5.3.0",
    "@iconify/react": "^5.2.1",
    "@mui/lab": "^7.0.0-beta.10",
    "@mui/material": "^7.0.1",
    "@mui/x-date-pickers": "^8",
    "apexcharts": "^4.5.0",
    "axios": "^1.19.0",
    "dayjs": "^1.11.13",
    "es-toolkit": "^1.34.1",
    "minimal-shared": "^1.0.7",
    "react": "19.1.0",
    "react-apexcharts": "^1.7.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.4.1",
    "simplebar-react": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.3.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5"
  }
}
