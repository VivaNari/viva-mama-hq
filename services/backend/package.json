{
    "name": "@vivamama/backend",
    "version": "1.0.0",
    "description": "VivaMama core API — Node.js + TypeScript + Express 5 service (MongoDB, Redis) powering onboarding, check-ins, the Viva Recovery Score, recommendations, payments and chat.",
    "main": "index.js",
    "scripts": {
        "clean": "rimraf dist",
        "rebuild": "npm run clean && npm run build",
        "test": "NODE_ENV=test jest",
        "dev": "nodemon --exec ts-node src/index.ts",
        "build": "tsc",
        "cron:week-progression": "ts-node src/cron-jobs/weekProgression",
        "job:consultation-reminders": "ts-node scripts/run-consultation-reminders.ts",
        "diagnose:consultation-reminders": "ts-node scripts/diagnose-consultation-reminders.ts",
        "diagnose:play-api": "ts-node scripts/diagnose-play-api.ts",
        "diagnose:otel": "ts-node scripts/verify-otel.ts",
        "diagnose:otel-http": "ts-node scripts/verify-otel-http.ts",
        "purge:user-data": "ts-node scripts/purge-user-data.ts",
        "seed:super-admin": "ts-node scripts/seed-super-admin.ts",
        "migrate:user-role": "ts-node scripts/backfill-user-role.ts",
        "migrate:hindi-translations": "ts-node scripts/add-hindi-translations.ts",
        "migrate:hindi-recommendations": "ts-node scripts/add-hindi-recommendations.ts",
        "migrate:hindi-products": "ts-node scripts/add-hindi-products.ts",
        "migrate:hindi-experts": "ts-node scripts/add-hindi-experts.ts",
        "migrate:hindi-care-managers": "ts-node scripts/add-hindi-care-managers.ts",
        "migrate:hindi-contents": "ts-node scripts/add-hindi-contents.ts",
        "migrate:add-expert-referral-codes": "ts-node scripts/add-expert-referral-codes.ts",
        "migrate:seed-referral-programs": "ts-node scripts/seed-referral-programs.ts",
        "migrate:seed-expert-categories": "ts-node scripts/seed-expert-categories.ts",
        "migrate:expert-category-to-ref": "ts-node scripts/migrate-expert-category-to-ref.ts",
        "migrate:add-consultant-contact-whatsapp": "ts-node scripts/add-consultant-contact-whatsapp.ts",
        "migrate:add-care-manager-remuneration": "ts-node scripts/add-care-manager-remuneration.ts",
        "migrate:consultation-order-to-consultant-ref": "ts-node scripts/migrate-consultation-order-to-consultant-ref.ts",
        "migrate:seed-subscription-plans": "ts-node scripts/seed-subscription-plans.ts",
        "migrate:add-play-product-ids": "ts-node scripts/add-play-product-ids.ts",
        "migrate:add-expert-empanelment": "ts-node scripts/add-expert-empanelment.ts",
        "migrate:add-np-category-to-contents": "ts-node scripts/add-np-category-to-contents.ts",
        "migrate:add-np-category-to-products": "ts-node scripts/add-np-category-to-products.ts",
        "migrate:add-np-category": "npm run migrate:add-np-category-to-contents && npm run migrate:add-np-category-to-products",
        "migrate:add-onboarding-feeding-node": "ts-node scripts/add-onboarding-feeding-node.ts",
        "migrate:rebrand-perinatal-flow-copy": "ts-node scripts/rebrand-perinatal-flow-copy.ts",
        "migrate:consultation-video-booking": "npm run migrate:add-consultant-contact-whatsapp && npm run migrate:add-care-manager-remuneration && npm run migrate:consultation-order-to-consultant-ref",
        "migrate:flow-copy": "npm run migrate:add-onboarding-feeding-node && npm run migrate:rebrand-perinatal-flow-copy",
        "start": "node build/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "k6:login": "k6 run load-tests/k6/login.js",
        "k6:checkin": "k6 run load-tests/k6/weekly-checkin-onboarding.js",
        "k6:products": "k6 run load-tests/k6/products.js",
        "k6:vivaclub": "k6 run load-tests/k6/viva-club.js"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "keywords": [],
    "author": "",
    "license": "Apache-2.0",
    "type": "commonjs",
    "dependencies": {
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/api-logs": "^0.222.0",
        "@opentelemetry/auto-instrumentations-node": "^0.80.0",
        "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
        "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
        "@opentelemetry/instrumentation": "^0.222.0",
        "@opentelemetry/instrumentation-pino": "^0.68.0",
        "@opentelemetry/resource-detector-gcp": "^0.57.0",
        "@opentelemetry/resources": "^2.11.0",
        "@opentelemetry/sdk-logs": "^0.222.0",
        "@opentelemetry/sdk-metrics": "^2.11.0",
        "@opentelemetry/sdk-node": "^0.222.0",
        "@opentelemetry/semantic-conventions": "^1.43.0",
        "@vivamama/contracts": "workspace:*",
        "axios": "^1.13.2",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "firebase-admin": "^13.6.0",
        "google-auth-library": "^10.4.0",
        "http-status-codes": "^2.3.0",
        "ioredis": "^5.8.2",
        "joi": "^18.0.1",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.19.0",
        "mongoose-sequence": "^6.0.1",
        "node-cron": "^4.2.1",
        "pino": "^10.1.0",
        "pino-http": "^11.0.0",
        "razorpay": "^2.9.6",
        "socket.io": "^4.8.1",
        "supertest": "^7.1.4",
        "twilio": "^5.10.2",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@eslint/eslintrc": "^3.3.1",
        "@types/cors": "^2.8.19",
        "@types/dotenv": "^6.1.1",
        "@types/express": "^5.0.3",
        "@types/http-status-codes": "^1.2.0",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mongoose-sequence": "^3.0.11",
        "@types/node": "^24.10.1",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.45.0",
        "@typescript-eslint/parser": "^8.45.0",
        "eslint": "^9.37.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-airbnb-typescript": "^18.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.4",
        "husky": "^9.1.7",
        "jest": "^30.2.0",
        "lint-staged": "^16.2.3",
        "mongodb-memory-server": "^11.2.0",
        "nodemon": "^3.1.10",
        "prettier": "^3.6.2",
        "rimraf": "^6.0.1",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "@tootallnate/once": "^3.0.1",
        "http-proxy-agent": "^7.0.0"
    }
}