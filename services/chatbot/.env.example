# VivaMama RAG Chatbot — environment configuration
# Copy to `.env` and fill in real values. NEVER commit a real .env.
# All keys map 1:1 to app/settings.py (case-insensitive); every value below is
# the code's own default unless marked REQUIRED.

# Runtime environment: dev | staging | production
ENV=dev

# ── LLM provider ─────────────────────────────────────────────────────
# vertex = Gemini on Vertex AI (default). groq = the legacy path, kept as a
# one-flag rollback. Switching providers also means overriding the three model
# IDs below, since those are provider-specific.
LLM_PROVIDER=vertex

# Vertex AI. Leave VERTEX_PROJECT empty to infer it from Application Default
# Credentials — the Cloud Run runtime service account in prod, or
# `gcloud auth application-default login` locally.
VERTEX_PROJECT=
# asia-south1 (Mumbai) keeps inference in-region for data residency.
VERTEX_LOCATION=asia-south1

# Required ONLY when LLM_PROVIDER=groq. Get a key at
# https://console.groq.com/keys (must start with "gsk_").
GROQ_API_KEY=

# Model IDs — these are the Vertex/Gemini defaults. For a Groq rollback set
# LLM_PROVIDER=groq and override all three, e.g. llama-3.3-70b-versatile and
# llama-3.1-8b-instant.
LLM_MODEL=gemini-2.5-flash
SCOPE_CLASSIFIER_MODEL=gemini-2.5-flash
TRANSLATION_MODEL=gemini-2.5-flash

# ── Internal API auth (REQUIRED) ─────────────────────────────────────
# Generate a strong key:  openssl rand -hex 32
API_KEY=replace_with_a_strong_random_key

# ── Redis (session memory) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
MEMORY_TTL_SECONDS=7200

# ── RAG retrieval ────────────────────────────────────────────────────
# Multilingual: maps Hindi/Hinglish queries and English documents into one
# shared semantic space. Changing this REQUIRES rebuilding the FAISS index
# (`python ingest_data.py`) — vector dimensions differ between models and
# load_index() refuses a mismatched index.
EMBEDDINGS_MODEL=BAAI/bge-m3
LOCAL_VECTOR_DIR=.local_vector_store
RAG_TOP_K=6
# Minimum similarity (0–1) for a chunk to be used as grounding context.
RAG_SCORE_THRESHOLD=0.55
# Below this, retry retrieval against an English translation of the query and
# keep whichever scored higher. Keeps the translation LLM off the hot path.
RAG_TRANSLATION_FALLBACK_THRESHOLD=0.75

# ── Embedding model delivery ─────────────────────────────────────────
# gs:// URI of the flat model folder downloaded at container start, so the
# ~2.3 GB model is not fetched at request time. Leave empty for local dev and
# for images that bake the model in; set it on Cloud Run, e.g.
# gs://vivamama-rag-model/bge-m3.
MODEL_GCS_URI=
# Where MODEL_GCS_URI is downloaded to. Used only when MODEL_GCS_URI is set.
MODEL_LOCAL_DIR=/models/bge-m3

# ── Product catalog ──────────────────────────────────────────────────
# Source: local | mcp
PRODUCTS_SOURCE=local
# ON by default: the products catalog is kept out of the prompt and the model is
# told not to recommend products. Set false to let Viva AI suggest products
# again. Referral programs can also suppress products per-user via the Node
# server's entitlement overrides — see app/mcp/tools/get_products_tool.py.
DISABLE_PRODUCT_RECOMMENDATIONS=true

# ── Content knowledge base ───────────────────────────────────────────
ENABLE_CONTENT_SOURCE=true
CONTENT_SEARCH_LIMIT=3
CONTENT_MIN_SCORE=0.5
CONTENT_MAX_CHARS=2400

# ── MongoDB ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=viva_mama

# ── Diagnostics ──────────────────────────────────────────────────────
# Log per-chunk progress during `python ingest_data.py`.
INGEST_PROGRESS=false
# Extra gate that re-checks the answer against the retrieved context before
# returning it. Off by default: it costs an LLM call per turn.
ENABLE_GROUNDING_GATE=false
