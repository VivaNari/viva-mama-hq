{
  "name": "@vivamama/growth-standards",
  "version": "0.1.0",
  "description": "WHO Child Growth Standards (2006) — LMS reference tables plus z-score and percentile calculation, shared by the VivaMama backend and mobile app.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "jest",
    "generate": "ts-node --project tsconfig.scripts.json scripts/generate-tables.ts",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "exceljs": "^4.4.0",
    "jest": "^30.5.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
